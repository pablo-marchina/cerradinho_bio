{
  "name": "guaratracking-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run tests/domain.vitest.test.ts",
    "test:watch": "vitest tests/domain.vitest.test.ts",
    "test:domain": "node --experimental-strip-types --test tests/*.node.test.mjs",
    "simulate:mqtt": "node scripts/simulate-mqtt-device.mjs",
    "postinstall": "msw init public --save",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.6.0",
    "mqtt": "^5.16.1",
    "msw": "^2.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.56.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
