{
  "version": 1,
  "author": "Grupo Guará",
  "editor": "wokwi",
  "serialMonitor": {
    "display": "always",
    "collapse": false
  },
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "chip-gps",
      "id": "gps",
      "top": 250,
      "left": 150,
      "attrs": {
        "latitude": "-23.55",
        "longitude": "-46.6333",
        "fixValid": "1"
      }
    },
    {
      "type": "wokwi-slide-switch",
      "id": "seal",
      "top": 235,
      "left": -170,
      "attrs": {
        "bounce": "0"
      }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "battery",
      "top": -150,
      "left": -200,
      "attrs": {
        "value": "800"
      },
      "rotate": 270
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_autorizar",
      "top": -40,
      "left": -197,
      "attrs": {
        "color": "green"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_ciclo",
      "top": 300,
      "left": -197,
      "attrs": {
        "color": "blue"
      }
    },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd",
      "top": 11.9,
      "left": 300,
      "attrs": {
        "pins": "i2c"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_voltar",
      "top": 140,
      "left": -197,
      "attrs": {
        "color": "white"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_avancar",
      "top": 50,
      "left": -197,
      "attrs": {
        "color": "white"
      }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": -130,
      "left": 150,
      "attrs": {
        "volume": "0.1"
      }
    },
    {
      "type": "wokwi-slide-switch",
      "id": "sw_rede",
      "top": 130,
      "left": 140,
      "attrs": {
        "bounce": "0"
      }
    },
    {
      "type": "wokwi-slide-switch",
      "id": "sw_energia",
      "top": 130,
      "left": 230,
      "attrs": {
        "bounce": "0"
      }
    },
    {
      "type": "wokwi-text",
      "id": "title",
      "top": -270,
      "left": -500,
      "attrs": {
        "text": "GUARATRACKING | Prototipo V2 (LCD, botoes de navegacao e buzzer)"
      }
    },
    {
      "type": "wokwi-text",
      "id": "batteryLabel",
      "top": -130,
      "left": -520,
      "attrs": {
        "text": "BATERIA | GPIO34\npotenciometro = nivel"
      }
    },
    {
      "type": "wokwi-text",
      "id": "buttonLabel",
      "top": -32,
      "left": -520,
      "attrs": {
        "text": "AUTORIZAR | GPIO33\nsegurar 3 s"
      }
    },
    {
      "type": "wokwi-text",
      "id": "navLabel",
      "top": 58,
      "left": -520,
      "attrs": {
        "text": "AVANCAR | GPIO25\nproxima tela"
      }
    },
    {
      "type": "wokwi-text",
      "id": "navLabel2",
      "top": 148,
      "left": -520,
      "attrs": {
        "text": "VOLTAR | GPIO26\ntela anterior"
      }
    },
    {
      "type": "wokwi-text",
      "id": "sealLabel",
      "top": 238,
      "left": -520,
      "attrs": {
        "text": "LACRE | GPIO27\nesq. integro | dir. violado"
      }
    },
    {
      "type": "wokwi-text",
      "id": "cycleLabel",
      "top": 308,
      "left": -520,
      "attrs": {
        "text": "CICLO | GPIO14\nsegurar 3 s inicia/encerra"
      }
    },
    {
      "type": "wokwi-text",
      "id": "buzzerLabel",
      "top": -120,
      "left": 245,
      "attrs": {
        "text": "BUZZER | GPIO23\nbipa na violacao"
      }
    },
    {
      "type": "wokwi-text",
      "id": "lcdLabel",
      "top": 160,
      "left": 310,
      "attrs": {
        "text": "LCD 16x2 I2C (0x27)\nSDA 21 | SCL 22 | VCC no VIN"
      }
    },
    {
      "type": "wokwi-text",
      "id": "networkLabel",
      "top": 200,
      "left": 112,
      "attrs": {
        "text": "REDE | GPIO18\nesq. = sinal"
      }
    },
    {
      "type": "wokwi-text",
      "id": "powerLabel",
      "top": 200,
      "left": 226,
      "attrs": {
        "text": "ON/OFF | GPIO19\nesq. = ligado"
      }
    },
    {
      "type": "wokwi-text",
      "id": "gpsLabel",
      "top": 300,
      "left": 150,
      "attrs": {
        "text": "GPS SIMULADO\nTX->RX2 16 | RX->TX2 17"
      }
    },
    {
      "type": "wokwi-text",
      "id": "notes",
      "top": 530,
      "left": -500,
      "attrs": {
        "text": "AVANCAR/VOLTAR trocam a tela do LCD (NF, prazo, posicao, bateria, lacre) em ordem circular\nSerial: REMESSA x = NF da remessa | NF = lanca NF de retorno | LIMIAR n = muda o limiar\nChave de rede simula o SIM (on/off); Wi-Fi real independente. Sem transporte ao servidor.\nDemo: 1 s = 1 dia no ciclo, coleta GPS a cada 30 s. Nao valida consumo ou autonomia.\nFios: preto GND | vermelho 3V3 | laranja VIN 5V | amarelo botoes e chaves | ciano bateria\n      verde SDA | azul SCL | roxo buzzer | cinza GPS"
      }
    }
  ],
