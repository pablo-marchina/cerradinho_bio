    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 470,
      "left": 410,
      "attrs": {
        "volume": "0.1"
      }
    },
    {
      "type": "wokwi-slide-switch",
      "id": "sw_rede",
      "top": 150,
      "left": -280,
      "attrs": {
        "bounce": "0"
      }
    },
    {
      "type": "wokwi-slide-switch",
      "id": "sw_energia",
      "top": 60,
      "left": -280,
      "attrs": {
        "bounce": "0"
      }
    },
    {
      "type": "wokwi-text",
      "id": "powerLabel",
      "top": 10,
      "left": -280,
      "attrs": {
        "text": "ON/OFF | GPIO19 | esquerda = ligado | direita = desligado"
      }
    },
    {
      "type": "wokwi-text",
      "id": "title",
      "top": -225,
      "left": -280,
      "attrs": {
        "text": "GUARATRACKING | Prototipo V2 (LCD, botoes de navegacao e buzzer)"
      }
    },
    {
      "type": "wokwi-text",
      "id": "gpsLabel",
      "top": -45,
      "left": 410,
      "attrs": {
        "text": "GPS SIMULADO | TX -> RX2/GPIO16 | RX -> TX2/GPIO17"
      }
    },
    {
      "type": "wokwi-text",
      "id": "sealLabel",
      "top": 140,
      "left": 410,
      "attrs": {
        "text": "LACRE | GPIO27 | esquerda = integro | direita = violado"
      }
    },
    {
      "type": "wokwi-text",
      "id": "batteryLabel",
      "top": 285,
      "left": 410,
      "attrs": {
        "text": "BATERIA SIMULADA | GPIO34 | nivel, nao e fonte de energia"
      }
    },
    {
      "type": "wokwi-text",
      "id": "networkLabel",
      "top": 95,
      "left": -280,
      "attrs": {
        "text": "REDE SIMULADA | GPIO18 | esquerda = disponivel | direita = indisponivel"
      }
    },
    {
      "type": "wokwi-text",
      "id": "buttonLabel",
      "top": 215,
      "left": -280,
      "attrs": {
        "text": "BOTOES | LOW = pressionado | ciclo e autorizar: segurar 3 s"
      }
    },
    {
      "type": "wokwi-text",
      "id": "notes",
      "top": 485,
      "left": -280,
      "attrs": {
        "text": "LCD 16x2 I2C (0x27, SDA 21 / SCL 22): NF, prazo, ultima posicao, bateria e lacre\nAVANCAR/VOLTAR trocam a tela em ordem circular; buzzer (GPIO23) bipa na violacao do lacre\nSerial: REMESSA x = NF da remessa; NF = lanca NF de retorno; LIMIAR n = muda o limiar\nChave de rede simula o SIM (on/off). Wi-Fi real independente da chave. Sem transporte ao servidor.\nDemo: 1 s = 1 dia no ciclo, coleta GPS a cada 30 s. Nao valida consumo ou autonomia."
      }
    },
    {
      "type": "wokwi-text",
      "id": "navLabel",
      "top": 440,
      "left": -280,
      "attrs": {
        "text": "NAVEGACAO | VOLTAR = GPIO26 | AVANCAR = GPIO25"
      }
    },
    {
      "type": "wokwi-text",
      "id": "buzzerLabel",
      "top": 440,
      "left": 410,
      "attrs": {
        "text": "BUZZER | GPIO23 | bipa so em violacao sem autorizacao"
      }
    }
  ],
