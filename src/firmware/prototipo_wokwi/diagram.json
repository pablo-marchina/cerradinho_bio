      "id": "esp",
      "top": 60,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "chip-gps",
      "id": "gps",
      "top": 0,
      "left": 410,
      "attrs": {
        "latitude": "-23.55",
        "longitude": "-46.6333",
        "fixValid": "1"
      }
    },
    {
      "type": "wokwi-slide-switch",
      "id": "seal",
      "top": 190,
      "left": 410,
      "attrs": {
        "bounce": "0"
      }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "battery",
      "top": 330,
      "left": 410,
      "attrs": {
        "value": "800"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_autorizar",
      "top": 260,
      "left": -280,
      "attrs": {
        "color": "green",
        "label": "BTN_AUTORIZAR (33)"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_ciclo",
      "top": 370,
      "left": -280,
      "attrs": {
        "color": "blue",
        "label": "BTN_CICLO (13)"
